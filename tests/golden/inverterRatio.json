{
  "function": "inverterRatio",
  "defaults": {
    "ratePhpPerKwh": 15.06,
    "yieldKwhPerKwpDay": 4,
    "panelWatts": 600,
    "panelAreaM2": 2.6,
    "priceLowPerKwp": 50000,
    "priceHighPerKwp": 70000,
    "exportCreditPhpPerKwh": 5.5,
    "daysPerMonth": 30
  },
  "tolerance": 0.01,
  "vectors": [
    {
      "label": "5.4 kWp on 5 kW",
      "input": {
        "arrayKwp": 5.4,
        "inverterAcKw": 5
      },
      "expected": {
        "ratio": 1.08,
        "flag": "ok"
      }
    },
    {
      "label": "7 kWp on 5 kW",
      "input": {
        "arrayKwp": 7,
        "inverterAcKw": 5
      },
      "expected": {
        "ratio": 1.4,
        "flag": "clipping_risk"
      }
    },
    {
      "label": "3 kWp on 5 kW",
      "input": {
        "arrayKwp": 3,
        "inverterAcKw": 5
      },
      "expected": {
        "ratio": 0.6,
        "flag": "undersized_array"
      }
    },
    {
      "label": "zero inverter",
      "input": {
        "arrayKwp": 5,
        "inverterAcKw": 0
      },
      "expected": {
        "ratio": null,
        "flag": "invalid"
      }
    },
    {
      "label": "exactly 1.3",
      "input": {
        "arrayKwp": 6.5,
        "inverterAcKw": 5
      },
      "expected": {
        "ratio": 1.3,
        "flag": "ok"
      }
    }
  ]
}