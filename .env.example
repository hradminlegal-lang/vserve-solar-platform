# Copy to .env.local (web) or set in Vercel / Supabase secrets. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are sent to the browser: only put public keys there.

# --- Supabase (prompt 03) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Full database access; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform (prompt 06) ---
# Browser key: restrict by HTTP referrer; Maps JavaScript + Places only.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server key: restrict by IP; Geocoding + Solar API.
GOOGLE_MAPS_SERVER_KEY=

# --- Energy simulation (prompt 11) ---
NREL_API_KEY=
# PVGIS needs no key.

# --- Claude API (prompt 07: bill reading) ---
ANTHROPIC_API_KEY=

# --- Messaging (prompt 04+) ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_NAME=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Ads lead capture (prompt 08) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
GOOGLE_ADS_WEBHOOK_KEY=

# --- PayMongo (prompt 17; test keys in dev and staging) ---
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=

# --- Odoo (prompt 17) ---
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# --- E-signature (provider not chosen yet) ---
ESIGN_API_KEY=

# --- Monitoring: off while empty ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
