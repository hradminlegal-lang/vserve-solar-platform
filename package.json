{
  "name": "vserve-solar-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@vserve/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @vserve/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:test:local": "packages/db/scripts/test-local.sh"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ]
  }
}
